{
  "name": "btl-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src packages/ui/src packages/api-client/src packages/contracts/src",
    "format": "prettier --write src packages",
    "format:check": "prettier --check src packages",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@codecash/api-client": "workspace:*",
    "@codecash/contracts": "workspace:*",
    "@codecash/ui": "workspace:*",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@reduxjs/toolkit": "2.8.2",
    "@tanstack/react-query": "^5.104.5",
    "antd": "^6.6.1",
    "dayjs": "^1.11.11",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-redux": "9.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
